# ==========================================================
# Portal Orc - Variáveis de Ambiente (Backend)
# ==========================================================
# INSTRUÇÕES PARA A EQUIPE:
# 1. Duplique este arquivo na mesma pasta.
# 2. Renomeie a cópia de ".env.example" para ".env".
# 3. Preencha os valores abaixo com as suas credenciais locais.
# ==========================================================

# --- Configuração do Google OAuth2 ---
# Gerado via Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=seu_client_id_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_segredo_real_aqui

DB_URL=jdbc:postgresql://localhost:5432/portal_orc
DB_USERNAME=portal_orc
DB_PASSWORD=orcestra

# JWT
JWT_EXPIRATION=900000
JWT_KEY=trocar_por_uma_chave_forte_em_producao

# Bootstrap do admin (apenas para desenvolvimento/teste)
ADMIN_EMAIL=admin@orcestra.com
ADMIN_PASSWORD=admin123
ADMIN_CPF=12345678901

# Email sender
EMAIL_USERNAME=
EMAIL_PASSWORD=